FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

COPY ["Migrations/Migrations.csproj", "Migrations/"]
COPY ["Common/Common.csproj", "Common/"]
COPY ["Models/Models.csproj", "Models/"]

WORKDIR "/src/Migrations"
RUN dotnet restore "Migrations.csproj"

# Copy only required source files for the Migrations project (avoid copying whole repo)
# Copy individual source files and the Scripts folder into the container
COPY Migrations/Program.cs Migrations/MigratorRunner.cs Migrations/VersionTable.cs /src/Migrations/
COPY Migrations/Scripts/ /src/Migrations/Scripts/

WORKDIR "/src/Migrations"
RUN dotnet build "Migrations.csproj" -c Release --no-restore
RUN dotnet publish "Migrations.csproj" -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/runtime:9.0
WORKDIR /app

ENV ASPNETCORE_ENVIRONMENT=Production
ENV DOTNET_ENVIRONMENT=Production

COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "Migrations.dll"]